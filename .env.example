NODE_ENV=development
DATABASE_URI=postgresql://intech:intech@127.0.0.1:5433/intech
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3200
